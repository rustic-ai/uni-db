diff --git a/crates/uni-query/src/query/df_planner.rs b/crates/uni-query/src/query/df_planner.rs
--- a/crates/uni-query/src/query/df_planner.rs
+++ b/crates/uni-query/src/query/df_planner.rs
@@ -2226,6 +2226,39 @@
                     indexed_preds.push(resolved);
                 }
             }
+            // TEETH RECONSTRUCTION — NOT A FIX. Reinstates the deleted range
+            // fusion at the site two-sided ranges are pushed today: an
+            // inclusive `col >= L` / `col <= U` pair on one indexed column is
+            // fused into the bespoke string `"col" >= L AND "col" <= U`. Lance
+            // parses a double-quoted name as a STRING LITERAL, so the clause
+            // is a data-independent constant. Scoped to that operator pair,
+            // the only one the fusion ever fired on.
+            {
+                use uni_store::backend::types::{CmpOp, FilterExpr as F};
+                let fused = range_parts.iter().find_map(|p| match p {
+                    F::Compare { column, op: CmpOp::GtEq, .. }
+                        if range_parts.iter().any(|q| {
+                            matches!(q, F::Compare { column: c, op: CmpOp::LtEq, .. } if c == column)
+                        }) =>
+                    {
+                        Some(column.clone())
+                    }
+                    _ => None,
+                });
+                if let Some(col) = fused {
+                    let (pair, rest): (Vec<_>, Vec<_>) =
+                        range_parts.into_iter().partition(|p| {
+                            matches!(p, F::Compare { column, op: CmpOp::GtEq | CmpOp::LtEq, .. } if *column == col)
+                        });
+                    let text: Vec<String> = pair
+                        .iter()
+                        .filter_map(|p| p.to_sql().ok())
+                        .map(|s| format!("\"{col}\"{}", &s[col.len() + 2..]))
+                        .collect();
+                    range_parts = rest;
+                    range_parts.push(F::Raw(text.join(" AND ")));
+                }
+            }
             lance_expr = uni_store::backend::types::FilterExpr::all(
                 std::iter::once(lance_expr).chain(range_parts),
             );
